# ---------------------------------------------------------------------------
# Supabase — copy this file to `.env.local` and fill in your project values.
#   Dashboard → Project Settings → API
#
# Both values are PUBLIC and safe to expose in the frontend bundle:
#   • The anon key only grants what Row-Level Security allows (public read,
#     authenticated write). See supabase/schema.sql.
#
# If these are left unset, the site runs fine on the built-in static data
# (src/data/*.js) and the /admin editor shows a "not configured" notice.
# ---------------------------------------------------------------------------
VITE_SUPABASE_URL=https://YOUR-PROJECT-ref.supabase.co
VITE_SUPABASE_ANON_KEY=YOUR-ANON-PUBLIC-KEY
